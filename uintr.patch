-
-#if 0
-	case UIPI_CLEAR_TARGET_TABLE:
-
-		/*
-		 * Clearing the UITT is a more involved procedure. The UITT
-		 * could be in use across multiple processes.
-		 */
-		ret = -EOPNOTSUPP;
