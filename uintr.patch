-	upid_ctx->upid->nc.nv = UINTR_KERNEL_VECTOR;
-	upid_ctx->waiting = true;
-	spin_lock_irqsave(&uintr_wait_lock, flags);
-	list_add(&upid_ctx->node, &uintr_wait_list);
-	spin_unlock_irqrestore(&uintr_wait_lock, flags);
-}
