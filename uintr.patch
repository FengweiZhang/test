-			upid_ctx->waiting = false;
-			set_tsk_thread_flag(upid_ctx->task, TIF_NOTIFY_SIGNAL);
-			wake_up_process(upid_ctx->task);
-			list_del(&upid_ctx->node);
-		}
-	}
-	spin_unlock_irqrestore(&uintr_wait_lock, flags);
-}
